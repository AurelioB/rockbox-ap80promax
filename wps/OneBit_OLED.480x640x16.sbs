# Credits to Chuck Lardo and D0-0K for inspiration and code/assets reused under CC-BY-SA and GPL V3 respectively.
# 2025-11-04 v1.4a

# Disable Status Bar
%wd

# Disable Title
#%?Lt<|>


# Preload Font
%Fl(2,07-LanaPixel.fnt)
%Fl(3,14-LanaPixel.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(usb,usb.bmp,0,0)
%xl(L,lock.bmp)
%xl(X,seeking_icon.bmp)

#__USB screen
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usb)|%Vd(navtouch)%Vd(info)%?or(%if(%ss(0,1,%St(background color)),>,7),%if(%ss(0,1,%St(background color)),>=,a),%if(%ss(2,1,%St(background color)),>,7),%if(%ss(2,1,%St(background color)),>=,a),%if(%ss(4,1,%St(background color)),>,7),%if(%ss(4,1,%St(background color)),>=,a))<%VI(menuDark)%Vd(infoDark)|%VI(menuLight)%Vd(infoLight)>>

#__Clear Screen
%Vi(clearScreen,60,0,1,1,-)

# Display Viewports

# Stock-sized, visual-neutral menu navigation targets.
%Vl(navtouch,0,0,480,80,-)
%T(0,0,120,80,cancel)
%T(360,0,120,80,contextmenu)

# Menu
%Vi(menuDark,20,90,440,450,-)%Vf(4c4c4c)
%Vi(menuLight,20,90,440,450,-)%Vf(7f7f7f)

# Menu Title
%Vl(infoDark,20,10,240,48,-)%Vf(4c4c4c)
%al%s%Lt
%Vl(infoLight,20,10,240,48,-)%Vf(7f7f7f)
%al%s%Lt

# Clock
%Vl(infoDark,300,21,72,20,3)%Vf(4c4c4c)
%ar%?cf<%cH|%cl>:%cM%?cf<| %cp>
%Vl(infoLight,300,21,72,20,3)%Vf(7f7f7f)
%ar%?cf<%cH|%cl>:%cM%?cf<| %cp>

# Battery (numerical)
%Vl(infoDark,378,21,50,20,3)%Vf(4c4c4c)
%ar%bl%%
%Vl(infoLight,378,21,50,20,3)%Vf(7f7f7f)
%ar%bl%%

#__Now Playing
%Vl(infoDark,118,590,252,16,2)%Vf(000000)
%?if(%mp, >, 1)<%al%s%?it<%it|%fn>%?ia< - %ia>%?id< - %id>%?iy< %(%ss(0,4, %iy)%)>|>
%Vl(infoLight,118,590,252,16,2)%Vf(ffffff)
%?if(%mp, >, 1)<%al%s%?it<%it|%fn>%?ia< - %ia>%?id< - %id>%?iy< %(%ss(0,4, %iy)%)>|>

# Playback Icons
%Vl(info,97,592,13,13,-)
%Vf(-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Storage Access
%Vl(info,272,25,12,12,-)
%Vf(-)
%xd(X,%lh)

# Hold
%Vl(info,287,25,9,12,-)
%Vf(-)
%xd(L,%mh)

# Battery viewport selector (flash when low, animates when charging)
%?bc<%Vd(battCharging)|%?if(%bl,>=,15)<%Vd(batt)|%Vd(lowBatt)>>

# Battery (graphical)
%Vl(batt,437,26,23,10,-)
%Vf(-)
%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>

%Vl(lowBatt,437,26,23,10,-)
%Vf(-)
%t(1)%?if(%bl,>=,10)<%xd(battery,2)|%xd(battery,1)>;%t(1)%xd(battery,12)

%Vl(battCharging,437,26,23,10,-)
%Vf(-)
%t(0.1)%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(1)%xd(battery,11)

#__USB
%Vl(usb,110,180,260,130,-)
%xd(usb)

%Vl(usb,100,400,280,-,3)
%acUSB CONNECTED

%Vl(usb,100,440,280,-,2)
%acEject Before Disconnecting
