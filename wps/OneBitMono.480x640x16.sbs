# Cicumpunct Δ
# Date: 05-24-2025

# Disable Status Bar
%wd

# Disable Title
#%?Lt<|>

# Preload Font
%Fl(2,07-LanaPixel.fnt)
%Fl(3,14-LanaPixel.fnt)
%Fl(4,20-digital7mono.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,10)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(usb,usb.bmp,0,0)
%xl(load,LoadStatus.bmp,10)

#__USB screen
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usb)|%VI(menu)%Vd(navtouch)%Vd(info)>

#__Clear Screen
%Vi(clearScreen,60,0,1,1,-)

# Display Viewports

# Stock-sized, visual-neutral menu navigation targets.
%Vl(navtouch,0,0,480,80,-)
%T(0,0,120,80,cancel)
%T(360,0,120,80,contextmenu)

# Menu
%Vi(menu,20,90,440,450,-)%Vf(-)%Vb(-)

# Menu Title
%Vl(info,85,25,123,15,2)
%al%Lt%s

# Load Indicator
%?lh<%Vd(loadstatus)|%Vd(loadstatic)>
%Vl(loadstatic,232,24,16,16,-)
%xd(load,1)
%Vl(loadstatus,232,24,16,16,-)
%t(0.2)%xd(load,2);%t(0.2)%xd(load,3);%t(0.2)%xd(load,4);%t(0.2)%xd(load,5);%t(0.2)%xd(load,6);%t(0.2)%xd(load,7);%t(0.2)%xd(load,8);%t(0.2)%xd(load,9);%t(0.3)%xd(load,10);%t(0.3)%xd(load,9)%t(0.3)%xd(load,8);%t(0.2)%xd(load,9);%t(0.2)%xd(load,10);%t(0.2)%xd(load,9);%t(0.2)%xd(load,8);%t(0.2)%xd(load,7);%t(0.2)%xd(load,6);%t(0.2)%xd(load,5);%t(0.2)%xd(load,4);%t(0.1)%xd(load,3);%t(0.1)%xd(load,2);%t(0.2)%xd(load,1)

#Hold indicator
%V(198,52,85,22,3)
%Vf(ffffff)
%?mh<LOCKED|>

# Clock
%Vl(info,310,25,50,15,2)
%ac%cl:%cM%cp

# Battery (numerical)
#%Vl(info,273,17,27,13,2)
#%ar%bl%%

#__Now Playing
%Vl(info,118,590,252,16,2)
%?if(%mp, >, 1)<%al%s%it - %ia - %id %(%ss(0,4, %iy)%)|>

# Playback Icons
%Vl(info,97,592,13,13,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Battery (graphical)
%Vl(info,367,28,23,10,-)
%?if(%bl,>,90)<%xd(battery,10)|%?if(%bl,>,80)<%xd(battery,9)|%?if(%bl,>,70)<%xd(battery,8)|%?if(%bl,>,60)<%xd(battery,7)|%?if(%bl,>,50)<%xd(battery,6)|%?if(%bl,>,40)<%xd(battery,5)|%?if(%bl,>,30)<%xd(battery,4)|%?if(%bl,>,20)<%xd(battery,3)|%?if(%bl,>,10)<%xd(battery,2)|%?if(%bl,>,-1)<%xd(battery,1)>>>>>>>>>>

#__USB
%Vl(usb,110,180,260,130,-)
%xd(usb)

%Vl(usb,100,400,280,-,3)
%acUSB CONNECTED

%Vl(usb,100,440,280,-,2)
%acEject Before Disconnecting
