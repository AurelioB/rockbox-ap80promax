# Theme by:chronicallyoffline/Cicumpunct Δ
# CC-BY-SA
# Credits to: chronicallyoffline for the theme he created, Chuck Lardo and D0-0K for inspiration and assets reused under CC-BY-SA and GPL V3 respectively,
# Cicumpunct Δ
# Date: 05-24-2025

# Disable Status Bar
%wd

# Clear Backdrop
%X(d)

# Preload Fonts
%Fl(2,29-squaredot.fnt)
%Fl(3,14-LanaPixel.fnt)
%Fl(4,10-Sazanami-Mincho.fnt)
%Fl(5,07-LanaPixel.fnt)
%Fl(6,21-LanaPixel.fnt)
%Fl(7,20-digital7mono.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,10)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(pbbd,progressbar_backdrop.bmp,0,0)
%xl(pl,pl.bmp,0,0)
%xl(plbg,plbg.bmp,0,0)
%xl(pr,pr.bmp,0,0)
%xl(prbg,prbg.bmp,0,0)
%xl(volbg,volbg.bmp,0,0)
%xl(vol,vol.bmp,0,0)
%xl(load,LoadStatus.bmp,10)

# Display Viewports
%V(0,0,-,-,-)
%?mh<%Vd(lockscreen)|%Vd(metadata)>

##################################
##### Locked (BW Monochrome) #####
##################################

# Clear Display
%Vl(lockscreen,0,0,360,640,-)

# Clock
%Vl(lockscreen,30,430,200,100,6)
%al%cl:%cM%cp

# Day
%Vl(lockscreen,30,395,200,25,5)
%al%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %cb %cd

# Battery Indicator
%Vl(lockscreen,250,430,80,100,6)
%ar%bl%%

# Charging Indicator
%Vl(lockscreen,250,395,80,25,5)
%ar%?bc<Charging|Voltage>

# Lock Indicator
%Vl(lockscreen,245,100,85,25,7)
%ac%?mh<LOCKED%Vs(invert)|>

# Album Artist
%Vl(lockscreen,30,100,200,30,3)
%al%s%ia

# Track Title or Filename
%Vl(lockscreen,30,150,300,40,2)
%al%s%it

# Album Title and ID3 Year
%Vl(lockscreen,30,230,210,20,5)
%al%s%id %(%ss(0,4, %iy)%)

# Shuffle Indicator
%Vl(lockscreen,250,234,23,12,4)
%al%?ps<SHUF>

# Repeat Indicator
%Vl(lockscreen,275,234,35,12,4)
%ac%?mm<|REPEAT|REPEAT|REPEAT|REPEAT>

# Repeat Mode Indicator
%Vl(lockscreen,314,234,17,12,4)
%ar%?mm<|ALL|ONE|SHUF|A-B>


#######################
##### Play Screen #####
#######################

# Clear Display
%Vl(metadata,0,0,360,640,-)

# Full-screen AP80 touch map, attached to the visible metadata viewport.
%T(0,0,120,70,browse)
%T(240,0,120,70,contextmenu)
%T(0,70,360,350,playlist)
%T(0,70,360,350,contextmenu,long_press)
%T(40,420,280,80,volume)
%T(40,500,280,70,progressbar)
%T(0,570,120,70,rwd,repeat_press)
%T(0,570,120,70,prev)
%T(120,570,120,70,play)
%T(120,570,120,70,stop,long_press)
%T(240,570,120,70,ffwd,repeat_press)
%T(240,570,120,70,next)

# Playback Mode Icons
%Vl(metadata,25,27,25,13,-)
%xd(playmodes,%mp)

# Track Number
%Vl(metadata,50,25,100,19,5)
%al%pp %Sx(of) %pe

# Clock
%Vl(metadata,240,25,60,15,5)
%ac%cl:%cM%cp
#
%?lh<%Vd(loadstatus)|%Vd(loadstatic)>
%Vl(loadstatic,172,25,16,16,-)
%xd(load,1)
%Vl(loadstatus,172,25,16,16,-)
%t(0.2)%xd(load,2);%t(0.2)%xd(load,3);%t(0.2)%xd(load,4);%t(0.2)%xd(load,5);%t(0.2)%xd(load,6);%t(0.2)%xd(load,7);%t(0.2)%xd(load,8);%t(0.2)%xd(load,9);%t(0.3)%xd(load,10);%t(0.3)%xd(load,9)%t(0.3)%xd(load,8);%t(0.2)%xd(load,9);%t(0.2)%xd(load,10);%t(0.2)%xd(load,9);%t(0.2)%xd(load,8);%t(0.2)%xd(load,7);%t(0.2)%xd(load,6);%t(0.2)%xd(load,5);%t(0.2)%xd(load,4);%t(0.1)%xd(load,3);%t(0.1)%xd(load,2);%t(0.2)%xd(load,1)

# Battery (graphical)
%Vl(metadata,307,28,23,10,-)
%?if(%bl,>,90)<%xd(battery,10)|%?if(%bl,>,80)<%xd(battery,9)|%?if(%bl,>,70)<%xd(battery,8)|%?if(%bl,>,60)<%xd(battery,7)|%?if(%bl,>,50)<%xd(battery,6)|%?if(%bl,>,40)<%xd(battery,5)|%?if(%bl,>,30)<%xd(battery,4)|%?if(%bl,>,20)<%xd(battery,3)|%?if(%bl,>,10)<%xd(battery,2)|%?if(%bl,>,-1)<%xd(battery,1)>>>>>>>>>>

# Album Artist
%Vl(metadata,40,105,200,30,3)
#%Vf(b4b4b4)
%al%s%ia

# Codec
%Vl(metadata,235,113,40,15,7)
%ac%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPAC|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUD|WMAVOX|MUSEPAK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?>%Vs(invert)

# Bitrate
%Vl(metadata,280,113,40,15,7)
%ac%fbk%Vs(invert)

# Track Title or Filename
%Vl(metadata,40,150,280,40,2)
%al%s%it

# Album Title and ID3 Year
%Vl(metadata,40,240,190,20,5)
%al%s%id %(%ss(0,4, %iy)%)

# Shuffle Indicator
%Vl(metadata,240,270,23,12,4)
%al%?ps<SHUF>

# Repeat Indicator
%Vl(metadata,265,270,35,12,4)
%ac%?mm<|REPEAT|REPEAT|REPEAT|REPEAT>

# Repeat Mode Indicator
%Vl(metadata,304,270,17,12,4)
%ar%?mm<|ALL|ONE|SHUF|A-B>

# Peak Meters
# Left
%Vl(metadata,40,360,140,30,-)
%pL(0,0,140,30,image,pl,backdrop,plbg,invert)

# Right
%Vl(metadata,180,360,140,30,-)
%pR(0,0,140,30,image,pr,backdrop,prbg)

# Volume Level Text
%Vl(metadata,280,450,40,10,4)
%ac%?if(%pv, >, 0)<+|>%pvdB

%Vl(metadata,50,450,35,10,4)
%alVOL-

# Volume Bar
%Vl(metadata,80,454,200,2,-)
%pv(0,0,200,1,vol,backdrop,volbg)

# Time Elapsed
%Vl(metadata,38,540,35,15,7)
%al%pc

# Progress Bar
%Vl(metadata,80,543,200,11,-)
%pb(0,0,200,9,progressbar.bmp,backdrop,pbbd)

# Total Track Time
%Vl(metadata,286,540,35,15,7)
%ac%pt
