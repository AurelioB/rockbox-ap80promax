# 2025-11-04 v1.4a

# Disable Status Bar
%wd

# Clear Backdrop
%X(d)


# Preload Fonts
%Fl(2,07-LanaPixel.fnt)
%Fl(3,14-LanaPixel.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,12)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(volbg,volbg_ap80.bmp,0,0)
%xl(vol,vol_ap80.bmp,0,0)
%xl(vuDark,level_meter_ap80.bmp,0,0,26)
%xl(vuDarkL,level_meter_L_ap80.bmp,0,0,26)
%xl(vuLight,level_meter_light_ap80.bmp,0,0,26)
%xl(vuLightL,level_meter_light_L_ap80.bmp,0,0,26)
%xl(R,repeat_status.bmp,4)
%xl(S,shuffle_status.bmp)
%xl(L,lock.bmp)
%xl(X,seeking_icon.bmp)


# Display Viewports
# Dedicated AP80 touch viewport, activated before visible theme viewports.
%Vl(touch,0,0,480,640,-)
%T(0,0,160,80,browse)
%T(160,0,160,80,menu)
%T(320,0,160,80,contextmenu)
%T(0,80,480,340,playlist)
%T(0,80,480,340,contextmenu,long_press)
%T(0,420,480,80,volume)
%T(0,500,480,60,progressbar)
%T(0,560,160,80,rwd,repeat_press)
%T(0,560,160,80,prev)
%T(160,560,160,80,play)
%T(160,560,160,80,stop,long_press)
%T(320,560,160,80,ffwd,repeat_press)
%T(320,560,160,80,next)

#%?mh<%Vd(lockscreen)|%Vd(metadata)>


# Light/Dark theme selector
%Vd(touch)
%?or(%if(%ss(0,1,%St(background color)),>,7),%if(%ss(0,1,%St(background color)),>=,a),%if(%ss(2,1,%St(background color)),>,7),%if(%ss(2,1,%St(background color)),>=,a),%if(%ss(4,1,%St(background color)),>,7),%if(%ss(4,1,%St(background color)),>=,a))<%Vd(darkFg)%?and(%C,%if(%St(volume display), =, graphic))<%Vd(albumArtDark)|%Vd(noAlbumArtDark)>%?ps<%Vd(repeatModeDark)|%?mm<%Vd(noRepeatDark)|%Vd(repeatModeDark)>>%?mv(3)<%Vd(volume)|%Vd(progDark)>|%Vd(lightFg)%?and(%C,%if(%St(volume display), =, graphic))<%Vd(albumArtLight)|%Vd(noAlbumArtLight)>%?ps<%Vd(repeatModeLight)|%?mm<%Vd(noRepeatLight)|%Vd(repeatModeLight)>>%?mv(3)<%Vd(volume)|%Vd(progLight)>>


# Album Art
%Cl(0,0,140,140,r,c)
%?and(%C,%if(%St(volume display), =, graphic))<%Vd(albumArt)>
%Vl(albumArt,320,90,140,140,-)
%Cd

#######################
##### Play Screen #####
#######################

# Playback Mode Icons
%V(20,25,13,13,-)
%Vf(-)
%xd(playmodes,%mp)

# Track Number (repeat)
%Vl(repeatModeDark,54,21,180,20,3)%Vf(5f605f)
%al%pp OF %pe
%Vl(repeatModeLight,54,21,180,20,3)%Vf(9C9E9C)
%al%pp OF %pe

# Track Number (no repeat)
%Vl(noRepeatDark,45,21,189,20,3)%Vf(5f605f)
%al%pp OF %pe
%Vl(noRepeatLight,45,21,189,20,3)%Vf(9C9E9C)
%al%pp OF %pe

# Repeat
%Vl(repeatModeDark,35,25,13,13,-)%Vf(-)
%t(5)%?ps<%xd(S)|%?mm<|%xd(R,%mm,-1)>>;%t(5)%?mm<%?ps<%xd(S)>|%xd(R,%mm,-1)>
%Vl(repeatModeLight,35,25,13,13,-)%Vf(-)
%t(5)%?ps<%xd(S)|%?mm<|%xd(R,%mm,-1)>>;%t(5)%?mm<%?ps<%xd(S)>|%xd(R,%mm,-1)>

# Clock
%Vl(darkFg,300,21,72,20,3)%Vf(5f605f)
%ar%?cf<%cH|%cl>:%cM%?cf<| %cp>
%Vl(lightFg,300,21,72,20,3)%Vf(9C9E9C)
%ar%?cf<%cH|%cl>:%cM%?cf<| %cp>

# Storage Access
%V(272,25,12,12,-)
%Vf(-)
%xd(X,%lh)

# Hold
%V(287,25,9,12,-)
%Vf(-)
%xd(L,%mh)

# Battery (numerical)
%Vl(darkFg,378,21,50,20,3)%Vf(5f605f)
%ar%bl%%
%Vl(lightFg,378,21,50,20,3)%Vf(9C9E9C)
%ar%bl%%

# Battery viewport selector (flash when low, animates when charging)
%?bc<%Vd(battCharging)|%?if(%bl,>=,15)<%Vd(batt)|%Vd(lowBatt)>>

# Battery (graphical)
%Vl(batt,437,26,23,10,-)
%Vf(-)
%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>

%Vl(lowBatt,437,26,23,10,-)
%Vf(-)
%t(1)%?if(%bl,>=,10)<%xd(battery,2)|%xd(battery,1)>;%t(1)%xd(battery,12)

%Vl(battCharging,437,26,23,10,-)
%Vf(-)
%t(0.1)%?bl<%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%?bl<%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>;%t(0.1)%xd(battery,11)

# Track Artist or Title
%Vl(noAlbumArtDark,20,90,-20,27,3)
%?ia<%Vf(5f605f)|%Vf(000000)>
%aL%s%?ia<%ia|%?it<%it|%fn>>
%Vl(noAlbumArtLight,20,90,-20,27,3)
%?ia<%Vf(9C9E9C)|%Vf(ffffff)>
%aL%s%?ia<%ia|%?it<%it|%fn>>

%Vl(albumArtDark,20,90,280,27,3)
%?ia<%Vf(5f605f)|%Vf(000000)>
%aL%s%?ia<%ia|%?it<%it|%fn>>
%Vl(albumArtLight,20,90,280,27,3)
%?ia<%Vf(9C9E9C)|%Vf(ffffff)>
%aL%s%?ia<%ia|%?it<%it|%fn>>

# Track Title
%Vl(noAlbumArtDark,20,130,-20,27,3)%Vf(000000)
%aL%s%?ia<%?it<%it|%fn>>
%Vl(noAlbumArtLight,20,130,-20,27,3)%Vf(ffffff)
%aL%s%?ia<%?it<%it|%fn>>

%Vl(albumArtDark,20,130,280,27,3)%Vf(000000)
%aL%s%?ia<%?it<%it|%fn>>
%Vl(albumArtLight,20,130,280,27,3)%Vf(ffffff)
%aL%s%?ia<%?it<%it|%fn>>

# Album Title and ID3 Year
#%V(105,115,195,15,2)%Vf(9C9E9C)
%Vl(noAlbumArtDark,20,230,-20,15,2)%Vf(5f605f)
%aL%s%?id<%id|Unknown Album> %(%?iy<%ss(0,4, %iy)|?>%)
%Vl(noAlbumArtLight,20,230,-20,15,2)%Vf(9C9E9C)
%aL%s%?id<%id|Unknown Album> %(%?iy<%ss(0,4, %iy)|?>%)

%Vl(albumArtDark,20,230,280,15,2)%Vf(5f605f)
%aL%s%?id<%id|Unknown Album> %(%?iy<%ss(0,4, %iy)|?>%)
%Vl(albumArtLight,20,230,280,15,2)%Vf(9C9E9C)
%aL%s%?id<%id|Unknown Album> %(%?iy<%ss(0,4, %iy)|?>%)

# Codec & Bitrate
#%V(105,133,195,15,2)
%Vl(darkFg,20,260,440,15,2)%Vf(676767)
%aL%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPACK|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUDIO|WMAVOICE|MUSEPACK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?> %?fv<~>%fbkbps

%Vl(lightFg,20,260,440,15,2)%Vf(989898)
%aL%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPACK|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUDIO|WMAVOICE|MUSEPACK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?> %?fv<~>%fbkbps

# Audio Meter
%Vl(noAlbumArtDark,20,360,220,5,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuLightL,%pL)>
%Vl(noAlbumArtDark,240,360,220,5,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuLight,%pR)>

%Vl(albumArtDark,20,340,280,3,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuLight,%pL)>
%Vl(albumArtDark,20,350,280,3,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuLight,%pR)>


%Vl(noAlbumArtLight,20,360,220,5,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuDarkL,%pL)>
%Vl(noAlbumArtLight,240,360,220,5,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuDark,%pR)>

%Vl(albumArtLight,20,340,280,3,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuDark,%pL)>
%Vl(albumArtLight,20,350,280,3,-)%Vf(-)
%?if(%St(battery display), =, graphic)<%xd(vuDark,%pR)>

# Volume Level Text
%Vl(volume,413,540,40,15,2)%Vf(05cffc)
%ac%?if(%pv, >, 0)<+|>%pvdB

%Vl(volume,20,540,40,15,2)%Vf(05cffc)
%alVOL-

# Volume Bar
%Vl(volume,80,548,320,2,-)%Vf(05cffc)
%pv(0,0,320,2,vol,backdrop,volbg)

# Time Elapsed
%Vl(progDark,20,540,40,15,2)%Vf(000000)
%al%?if(%pc,<,600)< |>%pc
%Vl(progLight,20,540,40,15,2)%Vf(ffffff)
%al%?if(%pc,<,600)< |>%pc

# Progress Bar
%Vl(progDark,80,546,320,5,-)%Vf(-)
%pb(-,0,-,4)
# Progress Bar
%Vl(progLight,80,546,320,5,-)%Vf(-)
%pb(-,0,-,4)

# Total Track Time
%Vl(progDark,413,540,40,15,2)%Vf(000000)
%ar%pt
%Vl(progLight,413,540,40,15,2)%Vf(ffffff)
%ar%pt
